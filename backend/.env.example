# GitHub
GITHUB_TOKEN=your_github_personal_access_token   # needs: repo scope
GITHUB_WEBHOOK_SECRET=your_webhook_secret         # random string, must match GitHub webhook config

# AI Provider (anthropic | groq | openai)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=your_ai_api_key
# AI_BASE_URL=https://api.groq.com/openai/v1      # optional: override base URL for custom endpoints

# Review behaviour
# Files are grouped and reviewed together for cross-file context.
# Lower = more isolated (safer for small token limits); higher = more context per call.
REVIEW_BUNDLE_THRESHOLD=10000

# Server
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/reviews.db
