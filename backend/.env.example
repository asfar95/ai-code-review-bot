# GitHub
GITHUB_TOKEN=your_github_personal_access_token   # needs: repo scope
GITHUB_WEBHOOK_SECRET=your_webhook_secret         # leave blank to skip signature verification

# AI — pick any provider below
#
# Provider    | AI_PROVIDER   | AI_MODEL                              | Free tier
# ------------|---------------|---------------------------------------|----------
# Groq        | groq          | llama-3.3-70b-versatile               | 100k TPD
# Groq (fast) | groq          | llama-3.1-8b-instant                  | 500k TPD, 6k TPM
# Gemini      | gemini        | gemini-2.0-flash                      | 1M TPD
# OpenAI      | openai        | gpt-4o-mini                           | paid
# Anthropic   | anthropic     | claude-haiku-4-5-20251001             | paid
# OpenRouter  | openrouter    | meta-llama/llama-3.3-70b-instruct:free| free models
# Together AI | together      | meta-llama/Llama-3-70b-chat-hf        | free credits
# Mistral     | mistral       | mistral-small-latest                  | paid
# Ollama      | ollama        | llama3.2                              | local/free
#
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=your_api_key
AI_BASE_URL=https://api.groq.com/openai/v1   # optional: omit to use provider default

# Server
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/reviews.db

# Review behaviour
# Files are grouped and sent together for cross-file context.
# Lower = more isolated reviews (safer for small token limits); higher = more context per call.
REVIEW_BUNDLE_THRESHOLD=10000
